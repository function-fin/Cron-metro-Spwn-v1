-- ==========================================
-- LÓGICA DO CRONÔMETRO
-- ==========================================
local rodando = false
local inicio = 0
local acumulado = 0
local renderConn = nil

local function formatarTempo(segundos)
	local min = math.floor(segundos / 60)
	local sec = math.floor(segundos % 60)
	local cent = math.floor((segundos * 100) % 100)
	return string.format("%02d:%02d.%02d", min, sec, cent)
end

local function atualizarTempo()
	local total
	if rodando then
		total = acumulado + (os.clock() - inicio)
	else
		total = acumulado
	end
	timeLabel.Text = formatarTempo(total)
end

local function iniciar()
	if rodando then return end
	rodando = true
	inicio = os.clock()
	startButton.Text = "Pausar"
	if renderConn then renderConn:Disconnect() end
	renderConn = RunService.RenderStepped:Connect(atualizarTempo)
end

local function pausar()
	if not rodando then return end
	acumulado = acumulado + (os.clock() - inicio)
	rodando = false
	startButton.Text = "Iniciar"
	if renderConn then
		renderConn:Disconnect()
		renderConn = nil
	end
	atualizarTempo()
end

local function resetar()
	rodando = false
	acumulado = 0
	inicio = 0
	if renderConn then
		renderConn:Disconnect()
		renderConn = nil
	end
	startButton.Text = "Iniciar"
	timeLabel.Text = "00:00.00"
end

startButton.MouseButton1Click:Connect(function()
	if rodando then pausar() else iniciar() end
end)

resetButton.MouseButton1Click:Connect(resetar)

